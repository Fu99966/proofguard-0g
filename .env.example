# The local HTTP service uses deterministic rules by default. Set rules-plus-models to opt in.
PROOFGUARD_REVIEW_MODE=rules-only
# Keep the API on loopback for local use. Other addresses print a warning on startup.
HOST=127.0.0.1
PORT=8787

# Optional for paid live private inference. Create a key at https://pc.0g.ai/dashboard/api-keys.
ZERO_G_API_KEY=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_MODEL=glm-5.3-flash
ZERO_G_CRITIC_MODEL=0gm-1.0-35b-a3b-sia
# Enables the two-reviewer committee for scripts and the reference Agent using the core adapter.
# PROOFGUARD_REVIEW_MODE controls the HTTP review path independently.
ZERO_G_ENABLE_COMMITTEE=true
# Forces demo responses in core adapter callers. The HTTP rules-plus-models mode requires live TEE configuration.
ZERO_G_FORCE_DEMO=false
ZERO_G_TRUST_MODE=private
# Optional public EVM address of the wallet allowed to consume a simulated permit.
PROOFGUARD_OWNER_ADDRESS=

# Comma-separated SHA-256 hex digests of high-entropy keys held by Agent clients.
PROOFGUARD_API_KEY_HASHES=
# Exact browser origins for cross-origin access, comma-separated. The built UI is same-origin.
PROOFGUARD_FRONTEND_ORIGINS=http://127.0.0.1:5173
PROOFGUARD_DATABASE_PATH=var/proofguard.sqlite
PROOFGUARD_AGENT_WALLET=
# Base Sepolia RPC and Chainlink price feed proxy addresses owned by the operator's configuration.
PROOFGUARD_RPC_URL=
PROOFGUARD_ETH_USD_FEED=
PROOFGUARD_USDC_USD_FEED=
# Optional Base Sepolia Safe Guard address and dedicated testnet-only issuer signing key.
PROOFGUARD_TESTNET_GUARD_ADDRESS=
PROOFGUARD_TESTNET_ISSUER_KEY=
# Optional persistent inference budget for an acceptance run. Set both fields together.
PROOFGUARD_ROUTER_REQUEST_LIMIT=
PROOFGUARD_ROUTER_BUDGET_ID=
